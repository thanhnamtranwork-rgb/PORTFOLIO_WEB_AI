# MoteLona runs its own Java NLP pipeline; no external AI API key is required.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=PortfolioAI_DB
MYSQL_USERNAME=portfolio_app
MYSQL_PASSWORD=change_this_password

# Restrict this to the exact production website origin when deploying.
MOTELONA_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000
# Local development: 127.0.0.1. Set 0.0.0.0 only for a hosted/container deployment.
MOTELONA_SERVER_ADDRESS=127.0.0.1
MOTELONA_PORT=8080
