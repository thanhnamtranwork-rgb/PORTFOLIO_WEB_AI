# Optional for the website and local Portfolio/glossary fallback.
# Required for Gemini generative answers. Keep this key on the backend only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent

# Optional model fallback chain: Gemini -> Groq -> OpenRouter -> local knowledge.
# Each provider is skipped unless its own API key is configured.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_API_ENDPOINT=https://openrouter.ai/api/v1/chat/completions

# Project root for searching approved documentation and source files.
# Set this as an operating-system/process environment variable; Spring Boot does not load .env automatically.
MOTELONA_PROJECT_ROOT=../../../../

# Use one database per application/project; Compass connects to the same server URI without the database suffix.
MONGODB_URI=mongodb://127.0.0.1:27017/motelona_portfolio

# Add the exact public site origins when deploying the backend.
MOTELONA_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000
# Local development uses 127.0.0.1. Use 0.0.0.0 only for a hosted/container deployment.
MOTELONA_SERVER_ADDRESS=127.0.0.1
MOTELONA_PORT=8080
